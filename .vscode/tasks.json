{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-tracker",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-std=c11",
                "-I${workspaceFolder}\\src",
                "-o",
                "${workspaceFolder}\\tracker.exe",
                "${workspaceFolder}\\src\\main.c",
                "${workspaceFolder}\\src\\timer.c",
                "${workspaceFolder}\\src\\detect.c",
                "${workspaceFolder}\\src\\study_ui.c",
                "${workspaceFolder}\\src\\warning.c"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}