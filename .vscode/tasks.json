
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-ui",
            "type": "shell",
            "command": "cl",
            "args": [
                "/nologo",
                "/Zi",
                "/utf-8",
                "/Fe:${workspaceFolder}\\tracker.exe",
                "${workspaceFolder}\\src\\ui-base.c",
                "${workspaceFolder}\\src\\study_ui.c",
                "${workspaceFolder}\\src\\warning.c"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
